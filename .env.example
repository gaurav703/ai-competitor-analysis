# Copy to .env and fill in. Never commit .env.
# One .env at the repo root is used by the web app, the worker and database tooling.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API / Connect) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string. Use the "Transaction pooler" URI (port 6543) for the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Same, but the "Session pooler" URI (port 5432). Used only by `pnpm db:migrate`.
DATABASE_MIGRATION_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Redis for the job queue (Upstash → Redis → TLS connection string) ---
REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-DB.upstash.io:6379

# --- LLM (D-002: OpenRouter free models for MVP) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_MAIN=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODEL_BACKUP=google/gemma-4-26b-a4b-it:free
EMBEDDING_MODEL=

# --- Worker ---
LOG_LEVEL=info
